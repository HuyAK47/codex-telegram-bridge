# Minimal env để chạy Codex Telegram Bridge.
# Copy file này thành .env rồi sửa 4-7 dòng đầu là đủ cho đa số nhu cầu.

# BẮT BUỘC: token bot từ @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace-me

# BẮT BUỘC: Telegram user ID được phép điều khiển bot.
TELEGRAM_ALLOWED_USER_IDS=123456789

# BẮT BUỘC: thư mục cha chứa các repo bot được phép truy cập.
WORKSPACE_ALLOWLIST=/home/dev/projects

# NÊN CÓ: đặt tên ngắn cho repo để dùng /repo chess thay vì path dài.
REPO_ALIASES=chess=/home/dev/projects/chess-app

# NÊN CÓ: repo mặc định khi bot vừa start hoặc chat chưa chọn repo.
DEFAULT_WORKSPACE=/home/dev/projects/chess-app

# NÊN CÓ nếu muốn Codex được sửa file sau khi bạn xác nhận /mode write hoặc /work 30m.
ALLOW_WRITE_MODE=true
WRITE_REPO_ALIASES=chess

# TUỲ CHỌN: override lệnh /test. Nếu bỏ trống, bridge tự dò từ repo đang chọn.
# TEST_COMMANDS='chess=flutter test,*=npm test'

# TUỲ CHỌN: giữ context Codex tốt hơn cho các câu follow-up ngắn.
CODEX_RESUME_LAST=true

# TUỲ CHỌN: lưu state/audit qua restart. Có thể bỏ nếu muốn chạy ephemeral.
SESSION_STATE_PATH=/home/dev/projects/codex-telegram-bridge-state.json
AUDIT_LOG_PATH=/home/dev/projects/codex-telegram-bridge-audit.jsonl

# TUỲ CHỌN: lưu ảnh Telegram để gửi vào Codex khi bạn gửi screenshot.
ATTACHMENT_DIR=/tmp/codex-telegram-bridge-attachments
