# Token Telegram bot lấy từ @BotFather. Giữ bí mật giá trị này.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Telegram user ID dạng số. Chỉ các user ID này được quyền điều khiển bot.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Tuỳ chọn: giới hạn thêm theo chat ID. Để trống nghĩa là mọi chat của user được allow đều dùng được.
TELEGRAM_ALLOWED_CHAT_IDS=

# Thư mục cha chứa các repo mà bot được phép truy cập.
WORKSPACE_ALLOWLIST=/home/dev/projects

# Repo mặc định khi chat chưa chọn repo hoặc chưa lưu repo mặc định.
DEFAULT_WORKSPACE=/home/dev/projects/chess-app

# Tên ngắn cho repo. Dùng /repo chess hoặc /set-default chess trong Telegram.
REPO_ALIASES=chess=/home/dev/projects/chess-app,bridge=/opt/codex-telegram-bridge

# Lệnh test theo từng repo. /test chạy trực tiếp từ bridge, ngoài Codex sandbox.
# Dùng cho verify nặng như Flutter/Gradle/npm/Maven để tránh sandbox blocker.
TEST_COMMANDS='chess=flutter test,backend=./gradlew --no-daemon test,bridge=npm test,*=npm test'

# Sandbox mặc định của Codex. Giữ read để khởi động an toàn; dùng /mode write hoặc /work 30m khi cần sửa file.
DEFAULT_CODEX_MODE=read

# Công tắc write cấp server. false sẽ chặn mọi yêu cầu write, kể cả khi Telegram xin bật write.
ALLOW_WRITE_MODE=true

# Chỉ các repo alias này được phép vào write mode. Nên khai báo rõ, không để quá rộng khi dùng thật.
WRITE_REPO_ALIASES=chess

# Thời gian write mode tự hết hạn, tính bằng mili-giây. 1800000 = 30 phút.
WRITE_MODE_TTL_MS=1800000

# Tên binary Codex hoặc đường dẫn tuyệt đối nếu codex không nằm trong PATH.
CODEX_BIN=codex

# Giữ false cho repo git thật. Chỉ bật true cho thư mục nháp không phải git repo.
CODEX_SKIP_GIT_REPO_CHECK=false

# Giữ false để chat sạch. Khi cần debug command Codex chạy thì dùng /verbose on trong Telegram.
CODEX_SHOW_COMMAND_EVENTS=false

# File audit JSONL ghi lại chọn repo, prompt, đổi mode, và các helper command.
AUDIT_LOG_PATH=/home/dev/projects/codex-telegram-bridge-audit.jsonl

# Lưu repo/verbose cuối cùng theo từng chat qua các lần restart; luôn khôi phục ở read-only mode.
SESSION_STATE_PATH=/home/dev/projects/codex-telegram-bridge-state.json

# Timeout cho helper command như /diff, /files, /test, /commit. 120000 = 2 phút.
WORKSPACE_COMMAND_TIMEOUT_MS=120000

# Khoảng thời gian bot báo “Still running...” khi Codex chạy lâu. 60000 = 60 giây; 0 là tắt.
HEARTBEAT_MS=60000

# Resume đúng thread Codex đã lưu để follow-up giữ context tốt hơn. Nếu gặp lỗi resume thì đổi về false.
CODEX_RESUME_LAST=true

# Profile riêng theo repo. Phải để trên một dòng và bọc quote để source .env không lỗi.
REPO_PROFILES_JSON='{"chess":{"cwd":".","notesPath":".codex-telegram/context.md","testCommand":"flutter test","defaultPrompt":"You are working on chess-app, a Flutter chess app. Be concise. Prefer small safe changes. Run relevant Flutter tests when possible.","commands":{"Flutter Test":"flutter test","Analyze":"flutter analyze","Gen l10n":"flutter gen-l10n","Build APK":"flutter build apk --split-per-abi"}},"backend":{"testCommand":"./gradlew --no-daemon test","defaultPrompt":"You are working on the backend service. Keep Gradle verification outside Codex sandbox via bridge commands.","commands":{"Backend Compile":"./gradlew --no-daemon compileJava","Backend Test":"./gradlew --no-daemon test","Backend Check":"./gradlew --no-daemon check"}},"bridge":{"testCommand":"npm test","defaultPrompt":"You are working on the Codex Telegram Bridge Node.js project. Keep security and tests first.","commands":{"Node Test":"npm test","Doctor":"npm run doctor"}}}'

# Verify profile nền cho monorepo hoặc toolchain nặng. cwd là đường dẫn tương đối bên trong workspace.
VERIFY_PROFILES_JSON='{"chess":{"cwd":"mobile","command":"flutter test","successText":"Flutter tests passed."},"backend":{"cwd":"backend","command":"./gradlew --no-daemon test","successText":"Backend tests passed."},"bonsai":{"cwd":".","command":"dart test","successText":"Dart tests passed."}}'

# Chạy verify runner theo shell local của bot. Giữ local-shell cho bản đầu tiên.
VERIFY_RUNNER_MODE=local-shell

# Bật tự động loop Codex -> verify -> Codex cho prompt sửa code.
AUTO_LOOP_DEFAULT=false

# Giới hạn số lần tự retry sau khi verify fail.
MAX_AUTO_LOOP_ATTEMPTS=3

# Host dashboard local. 127.0.0.1 nghĩa là chỉ máy đang chạy bot truy cập được.
DASHBOARD_HOST=127.0.0.1

# 0 là tắt dashboard. Đổi thành 8787 để bật http://127.0.0.1:8787/health và /sessions.
DASHBOARD_PORT=0

# Thư mục tạm lưu ảnh Telegram trước khi truyền cho Codex bằng --image.
ATTACHMENT_DIR=/tmp/codex-telegram-bridge-attachments

# Tuổi tối đa của file ảnh tạm trước khi /cleanup xoá. 86400000 = 24 giờ.
ATTACHMENT_MAX_AGE_MS=86400000

# Tuỳ chọn: file JSON chứa tham số thêm cho Codex CLI, ví dụ ["--model","gpt-5.2"]
# CODEX_EXTRA_ARGS=/absolute/path/to/codex-extra-args.json
